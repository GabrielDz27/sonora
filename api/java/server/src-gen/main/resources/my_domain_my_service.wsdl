                    </xsd:simpleType>
                    </xsd:element>
                    <!-- collection wrapper for pecaFuncionario -->
                    <xsd:element name="pecaFuncionario" minOccurs="0" maxOccurs="1">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="item" type="pecaFuncionario" minOccurs="0" maxOccurs="unbounded"/>
                            </xsd:sequence>
