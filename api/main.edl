domain my_domain

entities {
    generateExtraResources : true
    securityType : secure
    enumType : string
}

service my_service {
	entities {
	   entity peca {
	        generateCustomValidator: true
	   }

       entity funcionario {
            generateCustomValidator: true
       }

       entity maquina {
            generateCustomValidator: true
       }

       entity registroProducao {
            relationships {
                ManyToOne(peca) {
                    type: aggregation
                }
                ManyToOne(funcionario) {
                    type: aggregation
                }
                ManyToOne(maquina) {
                    type: aggregation
                }
            }
       }
	}

}