domain my_domain

service my_service {
    endpoints {
        query helloWorld {
            in {
                who : string
            }
            out {
                helloWorldMessage : string
            }
        }
    }

    types {

        //enum
        enumeration statusPeca {
            PENDENTE
            PROCESSO
            FINALIZADO
            MORTA
        }

        enumeration statusMaquina {
            ATIVO
            MANUTENCAO
            INATIVO
        }

        enumeration turnoFuncionario {
            PRIMEIRO
            SEGUNDO
            TERCEIRO
            DIURNO
        }
    }

    entities {
        entity peca {
            id: uuid?
            nome: string
            codigoDesenho: string
            tempoEstimadoMinutos: integer
            status: statusPeca
        }

        entity funcionario {
            id: uuid?
            nome: string
            matricula: string
            cargo: string
            turno: turnoFuncionario
        }

        entity maquina {
            id: uuid?
            nome: string
            status: statusMaquina
        }

        entity registro_producao {
            id: uuid?
            peca: peca?
            funcionario: funcionario?
            maquina: maquina?
            dataInicio: dateTime
            dataFinal: dateTime
        }
    }
} 